# ~/.claude is mostly machine-local state (sessions, caches, history, plugins),
# so ignore everything and whitelist only the config worth versioning.
*

!/.gitignore
!/.markdownlint.jsonc
!/CLAUDE.md
!/README.md
!/keybindings.json
!/settings.json

# Own skills. Anything else under skills/ is managed by Claude Code itself.
!/skills/
!/skills/**
/skills/synced/
/skills/.trash/

.DS_Store
